#Ansible


- name: Install MariaDB for dkkotnala
  hosts: all
  become: yes

  tasks:
  - name: Install MariaDB
    yum: 
    name: mariadb-server
    state: present
  
  - name: Start MariaDB
    service:
     name: mariadb
     state: started
     enabled: yes



#Terraform


recource "aws_instance" "dkkotnalaServer"{
  ami           = "amiami-0abcd1234abcd1234"
  instance_type = "r5.2xlarge"
  }

  tags = {
  Name = "dkkotnala-output-EC2"
  }
}

output "dkkotnalaPublicIP" {
  value = aws_instance.PathnexServer.public_ip
}



