#ansible


- name: Deploy app from Git for Pathnex
  hosts: all
  become: yes

  tasks:
    - name: Install git
     yum:
       name: git
       state: present

    - name: Clone repository
     git:
       repo: "https://github.com/pathnex/app.git"
       dest: "/opt/pathnex-app"



#Terraform


resource "aws_db_instance" "dkkotnalaRDS" {
  allocated_storage      = 20
  engine                 = "mysql"
  instance_class         = "db.t3.micro"
  username               = "admin"
  password               = "dkkotnala123"
  skip_final_snapshot    = true
}


#Kubernetes


apiVersion: apps/v1
kind: Deployment
metadata:
  name: dkkotnala-rollout
spec:
  replicas: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
     maxSurge: 2
     maxUnavailable: 1
  selector:
    matchLabels:
     app: rollout
  template:
    metadata:
      labels:
       app: rollout
    spec:
      containers:
        - name: app
         image: nginx


