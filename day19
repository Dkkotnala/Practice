#Jenkins Pipeline


pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "dkkotnala"
    }
    stages {
        stage('Deploy') {
            steps {
                input message: "Approve deployment for $INSTITUTE_NAME?"
                sh 'echo "Deployment approved and executed!"'
            }
        }
    }
}


#GitLab CI

stages:
  - deploy

variables:
  INSTITUTE_NAME: "dkkotnala"

deploy:
