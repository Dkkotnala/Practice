#ansible - install and enable nginx

- name: start and Install nginx on dkotnala
  hosts: all
  become: yes

  tasks:
  - name: Install nginx
    yum:
      name: nginx
      state: present

  - name: Enable nginx
    service: 
    name: nginx
    state: started
    Enabled: yes

#--------------------------

#terraform - Ec2 with tags

provider "aws" {
  region = "us-east-1"
}

resource "aws_instance" "dkotnala"{
  ami      = "ami-0abcd1234abcd1234"
  instance_type = "r5.2xlarge"


tags = {
  name       = "dkotnala-server"
  environment = "Training"
  owner      = "dkotnala"
  }
}


#-----------------------------

#kubernetes- deployment with 2 replica

apiVersion: apps/v1
kind: Deployment
metadata:
  name: dkotnala-deployment
spec:
  replicas: 2
  selector: 
    matchLabels:
      app: "dkotnala-app"
  template:
    metadata:
    labels:
     app: dkotnala-app
  spec:
    containers:
  - name: app
    image: nginx
    ports:
     - containerPort: 80

