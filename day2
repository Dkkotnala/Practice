  stage: test
  image: Maven:3.8.1-jdk-17
  script:
  - cd sample-java-app
  - mvn test

maven-package:
  stage: package
  image: Maven:3.8.1-jdk-17
  script:
  - cd sample-java-app
  - mvn package  