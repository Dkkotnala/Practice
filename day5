## terraform 

resource "aws_instance" "dkotnala"
  ami             = "ami-0abcd1234abcd1234"
  instance_type   = "c6a.12xlarge"  

  user_data = <<EOF
#!/bin/bash
yum install -y httpd
systemctl start httpd
EOF

tags = {
  Name = "dkotnala-EC2"
 }
}

