#jenkin pipeline

pipeline{
  agent any
  environment {
    INSTITUDE_NAME = "dkotnala"
  }
stages {
    stage('print') {
      steps {
        sh 'echo "Welcome to $INSTITUDE_NAME Devops training"'
      }
  }
    stage('Build'){
      steps{
        sh 'mvn clean package -Dinstitute.name=$INSTITUDE_NAME'
      }
    }
  }
} 


