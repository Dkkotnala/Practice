#Ansible

- name: Manage Nginx
  hosts: all
  become: yes

  tasks:
    - name: Update config file
      copy:
        src: index.html
        dest: /usr/share/ngnix/html/index.html
      notify: Restart Ngnix

  handless:
    - name: Restart Ngnix
      service:
         name:  nginx
         state: restarted

