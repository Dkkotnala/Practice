#-------------
#ansible — Install Packages Using Variables

- name: Install Packages using Variables
  hosts: all
  become: yes

  vars:
    dkotnala_packages:
    - tree
    - unzip
    - vim

- name: Install required packages
  yum:
   name: "{{pathnex_packages }}"
   state: present



#-----------------------
#terraform — Create VPC + Subnet

provider "aws" {
  region = "ap-south-1"
}

resource "aws_vpc" "dkotnalaVPC"{
  cidr_block = "10.10.0.0/16"

  tags ={
    Name = "dkotnala-VPC"
  }
}

resource "aws_subnets" "dkotnalasubnets" {
    vpc_id                   = aws_vpc.dkotnala.vpc_id
    cidr_block               = "10.10.0.0/16"
    map_public_ip_on_launch  = true

  tags = {
    Name = "dkotnala-subnets"
  }
}


#-------------------------
#kubernetes Add Liveness & Readiness Probes

apiVersion: v1
kind: pod 
metadata:
    name: dkotnala-prob-pod
spec: 
  containers:
    - name: web
      image: nginx
      LivenessProbe:
        httpGet:
         path: /
         port: 80
         initialDelaySeconds: 5
      ReadinessProbe:
        httpGet:
          path: /
          port: 80
          initialDelaySeconds: 3

