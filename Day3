#terraform


provider "aws"{
  region = "us-east-1"
}

  resource "aws_security_group" "dkotnalaSG"{
    name        = "dkotnalaSG"
    description = "dkotnala SG for SSH"

  igress {
    from_port   = 22
    to_port     = 22
    protocol    ="tcp"
    cidr_blocks =["0.0.0.0/0"]
   }
  }

  resource "aws_instance" "dkotnala"{
  ami                   ="ami-0abcd1234abcd1234"
  instance_type          ="r6i.4xlarge"
  vpc_security_group_ids = [aws_security_group.dkotnalaSG.id]

  tags= {
  Name = "dkotnala-EC2"
  }
}

