#terraform: EC2(chose any pathnex instance)

provider "aws"{
  region= "ap-south-1"
}
resource "aws_instance" "pathnexEC2"{
  ami             = "ami-0abcd1234abcd1234"
  instance_type   = "c7.xlarge"
tags = {
  Name = "pathnexEC2"
 }
}



#----------------------------------
#Kubernetes: Deployment 2 replicas

apiVersion: v1
kind: Deployment
metadata:
    name: pathnex-deployment
  spec:
    replicas: 2
    selector:
      matchlabels:
      app: pathnex-app
  template:
      metadata:
      label:
      app: pathnex-app
  spec:
    containers:
    - name: app
      image: ngnix
      ports:
        - containerPort: 80

