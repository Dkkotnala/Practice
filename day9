#ansible deploying jinja2 template

- name: deploy template for dkkotnala
  hosts: all
  become: yes

  tasks:
    - name: copy template file
      template:
        src: pathnex.conf.j2 
        dest: /etc/pathnex.conf 

#------------------------------
#terraform internet gateway

resorce "aws_internet_gateway" "pathnexIGW"{
  vpc_id = aws_vpc.pathnexVPC.vpc_id

  tags = {
    Name: "pathnex-IGW"
  }
}

