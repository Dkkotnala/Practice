#-----------------------------
# Jenkins Pipeline

pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "dkkotnala"
    }
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Pathnex/sample-java-app.git'
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }
}


#-----------------------
#GitLab CI — Artifacts

stage:
  - build

build:
  stage: build
  image: maven:3.8.1-jdk-17
  script:
  - git clone: https://github.com/Pathnex/sample-java-app.git
  - cd sample-java-app
  - mvn clean package
  artifacts:
    paths:
    - target/*.jar
   expire_in: 1 week