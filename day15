#ansible


-- name: Insatall Java on Dkkotnla server
   hosts: all
   become: yes

   tasks:
   - name: Insatall OpenJDK
      yum:
         name: java-11-Openjdk 
         state: present

   - name: Set JAVA_HOME
     lineinfile:
         path: /etc/profile
         line: 'export JAVA_HOME=/usr/lib/jvm/java-11-openjdk'


#terraform

provider "aws" {
   region = "us-east-1"
}

resource "aws_s3_bucket" "DkkotnalaBucket" {
   bucket = "Dkkotnla-devops-bucket"

   tags = {
      Name = "DkkotnalaBucket"
   }
}


#kubernetes

apiVersion: batch/v1
kind: CronJob
metadat:
   name: pathnex-Cron
spec:
   schedule: "*/5 * * * *"
   jobTemplate:
      spec:
         template:
          spec:
            containers:
               -name: job
               image: busybox
               command: ["sh","-c", "echo Dkkotnla CronJob running"]
         restartPolicy: OnFailure



