#anisble - Installing multiple package

- name: Install package for dkotnala
  hosts: all
  become: yes


  tasks:
    - name: Insatll tools
      yum:
        name: 
          - git
          - wget
      state: present


#terraform - EC2 with Key Pair

provider "aws" {
  region = "us-east-1"
}

resource "aws_key_pair" "dkotnala" {
  key_name   = "dkotnala"
  public_key = "ssh-rsa AAAA..."
}

resource "aws_instance" "dkotnalaEC2"{
  ami            = "ami-0abcd1234abcd1234"
  instance_type  = "c6i.8xlarge"
  key_name       = aws_key_pair.PathnexKey.key_name

  tags = {
    Name = "dkotnalaEC2" 
  }  
}


## 🔹 Jenkins Pipeline — Parallel Build & Test

pipeline {
  agent any
    stages {
      stage('Parallel tasks'){
        parallel{
        stage('Build') {
          steps{
          sh 'mvn clean compile'
          }
        }
        stage('Test') {
        steps {
         sh 'mvn test'
         }
       }
      }
    }
  }
}


#kubernetes - create ClusterIP service

apiVersion: v1
kind: Service 
metadata:
   name: dkotnala-service
spec:
  selector: 
     app: dkotnala-app
  ports:
   - port: 80
     targetport: 80


#Gitlab CLI - parallel Jobs

stages: 
   - build-test

maven-build:
  stage: build-test
  image: maven: 3.8.1-jdk-17
  script:
   - git clone https://github.com/Pathnex/sample-java-app.git
   - cd sample-java-app
   - mvn clean compile
parallel: 1


maven-test:
  stage: build-test
  image: maven:3.8.1-jdk-17
  script: 
   - cd sample-java-app
   - mvn test
  parallel: 1