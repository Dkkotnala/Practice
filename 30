#ansible 

-- name: install ngnix on pathnex server
    hosts: all
    become: yes
    
    tasks:
    -- name: Insatll ngnix
    yum:
    name: ngnix
    state: present


#terrform

provider "aws"{
    region= "ap-south"
}

resource "aws_instance" "pathnexEC2"{
    ami = "ami-0abcd1234abcd1234"
}
instance_type = "c5.xlarge"

tags = {
    Name = "pathnex-EC2"
  }
}

#Kuberenetes

apiVersion: v1
kind: Pod 
metadata: 
    name: pathnex-pod 
  spec: 
    container: 
    -- name: web    
        image: ngnix:latest
        ports:
        - containerPort: 80



