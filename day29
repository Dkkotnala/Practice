#terraform

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "ap-south-1"
}

variable "instance_type" {
  default = "c5.xlarge" 
}

resource "aws_key_pair" "pathnex" {
  key_name   = "pathnex-day29-key"
  public_key = file("~/.ssh/id_rsa.pub")
}

resource "aws_security_group" "pathnex" {
  name = "pathnex-day29-sg"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "pathnex" {
  ami                    = var.ami_id
  instance_type          = var.instance_type
  key_name               = aws_key_pair.pathnex.key_name
  vpc_security_group_ids = [aws_security_group.pathnex.id]

  tags = {
    Name = "pathnex-day29-ec2"
  }
}

resource "aws_ebs_volume" "pathnex" {
  availability_zone = aws_instance.pathnex.availability_zone
  size              = 20
}

resource "aws_volume_attachment" "pathnex" {
  device_name = "/dev/sdf"
  volume_id   = aws_ebs_volume.pathnex.id
  instance_id = aws_instance.pathnex.id
}

output "instance_public_ip" {
  value = aws_instance.pathnex.public_ip
}


#ansible

- name: Deploy Pathnex welcome page on nginx
  hosts: webservers
  become: true

  tasks:
    - name: Install nginx
      package:
        name: nginx
        state: present

    - name: Deploy Welcome to Pathnex page
      copy:
        content: "<h1>Welcome to Pathnex</h1>"
        dest: /usr/share/nginx/html/index.html

    - name: Start and enable nginx
      service:
        name: nginx
        state: started
        enabled: true


#kubernetes

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pathnex-pvc
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pathnex-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pathnex
  template:
    metadata:
      labels:
        app: pathnex
    spec:
      containers:
        - name: pathnex-nginx
          image: nginx:latest
          ports:
            - containerPort: 80
          volumeMounts:
            - name: pathnex-storage
              mountPath: /usr/share/nginx/html
      volumes:
        - name: pathnex-storage
          persistentVolumeClaim:
            claimName: pathnex-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: pathnex-service
spec:
  type: NodePort
  selector:
    app: pathnex
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30080


